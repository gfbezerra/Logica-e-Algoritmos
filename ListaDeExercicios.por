programa {
  funcao inicio() {

    real a, b, c, d, soma, subtracao, multiplicacao, divisao, dobro, triplo, sucessor, antecessor, area, perimetro

    //Soma

    escreva ("Digite um número: ")
    leia(a)

    escreva ("Digite outro número: ")
    leia(b)

    soma = a + b

    escreva ("A soma de a + b é igual a: ", soma)

    //Subtração

    escreva ("\n Digite um número: ")
    leia(a)

    escreva("\n Digite outro número: ")
    leia(b)

    subtracao = a - b

    escreva("A subtracao de a - b é igual a: ", subtracao)

    //Multiplicação

    escreva ("\n Digite um número: ")
    leia(a)

    escreva("\n Digite outro número: ")
    leia(b)

    multiplicacao = a * b

    escreva("A multiplicacao de a * b é igual a: ", multiplicacao)

    //Divisão

    escreva("\n Digite um número: ")
    leia(a)

    escreva("\n Digite outro número: ")
    leia(b)

    divisao = a / b

    escreva("A divisão de a / b é igual a: ", divisao)

    //Dobro

    escreva("\n Digite um número: ")
    leia(a)

    dobro = a * 2

    escreva("\n O dobro do número ", a, " é igual a: ", dobro)

    //Triplo

    escreva("\n Digite um número: ")
    leia(a)

    triplo = a * 3

    escreva("\n O triplo do número ", a, " é igual a: ", triplo)

    //Sucessor

    escreva("\n Digite um número: ")
    leia(a)

    sucessor = a + 1

    escreva("O sucessor do número ", a, " é igual a: ", sucessor)

    //Antecessor

    escreva("\n Digite um número: ")
    leia(a)

    antecessor = a - 1

    escreva("O antecessor do número ", a, " é igual a: ", antecessor)

    //Área do Triângulo

    escreva("\n Digite a medida da base do triângulo: ")
    leia(a)

    escreva("\n Digite a medida da altura do triângulo: ")
    leia(b)

    area = (a * b)/2

    escreva("\n A área do triângulo é de: ", area) 

    //Perímetro do Retângulo

    escreva("\n Digite a medida do lado 1 do retângulo: ")
    leia(a)

    escreva ("\n Digite a medida do lado 2 do retângulo: ")
    leia(b)

    escreva("\n Digite a medida do lado 3 do retângulo: ")
    leia(c)

    escreva ("\n Digite a medida do lado 4 do retângulo: ")
    leia(d)

    perimetro = a + b + c + d

    escreva("\n O perímetro desse retângulo é de: ", perimetro)






    





    
  }
}
