programa {
  funcao inicio() {

    inteiro a, b, c, maior

    escreva("Digite um número: ")
    leia(a)
    escreva("Digite outro número: ")
    leia(b)
    escreva("Digite outro número: ")
    leia(c)

    maior = a

    se (b > maior)
    maior = b

    se (c > maior)
    maior = c

    escreva ("Maior = ", maior)

    
    }
  }
}
