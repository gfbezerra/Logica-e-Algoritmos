programa {
  funcao inicio() {

    inteiro cadastro, senha
  

    escreva ("Cadastre uma senha com números apenas: ")
    leia(cadastro)

    cadastro == senha

    escreva ("Digite sua senha: ")
    leia(senha)

    se (cadastro == senha) 
      escreva("Você fez login!")

    senao 
      escreva("Senha INVALIDA!")



    

    
    
  }
}
