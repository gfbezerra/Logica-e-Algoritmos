programa {
  funcao inicio() {

    inteiro idade
    logico autorizacao 
    
  

      escreva("Qual sua idade?: ")
        leia(idade)

      escreva("Possui autorizacao?: ")
        leia(autorizacao)

      
      se (idade >= 12 e idade <= 18 e autorizacao)
        escreva("Pode entrar!")
      senao 
        escreva("Não pode entrar!")

    
  }
}
